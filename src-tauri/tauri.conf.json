{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SQL Designer",
  "version": "1.3.0",
  "identifier": "com.jaderdiaz.sql-designer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SQL Designer",
        "width": 820,
        "height": 580,
        "minWidth": 820,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Jader Luis Diaz E.",
    "shortDescription": "Diseñador visual de bases de datos relacionales",
    "category": "DeveloperTool"
  }
}
